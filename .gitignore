# ==============================================================================
# ZAPIN - Git Ignore Configuration
# RSJKO Engku Haji Daud
# ==============================================================================

# Dependencies & Package Managers
/node_modules/
/vendor/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
auth.json

# Environment & Secret Credentials
.env
.env.*
!.env.example
*.key
*.pem
*.crt

# Public Builds & Uploaded Assets
/public/build/
/public/hot/
/public/storage
/public/uploads/*
/public/uploads/**/*
!/public/uploads/**/.gitignore
!/public/uploads/**/.gitkeep

# Database, SQL Dumps & Raw Datasets
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
!/database/database.sqlite.example
*.sql
*.sql.gz
*.dump
/database/csv_source/*
!/database/csv_source/.gitkeep
/database/sertifikat/*
!/database/sertifikat/.gitignore
!/database/sertifikat/.gitkeep

# Laravel Storage & Framework Cache
/storage/*.key
/storage/*.txt
/storage/app/*
!/storage/app/.gitignore
!/storage/app/.gitkeep
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitignore
!/storage/app/public/.gitkeep
/storage/backups/*
!/storage/backups/.gitignore
!/storage/backups/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitignore
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitignore
!/storage/logs/.gitkeep
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Testing & Code Coverage
*.log
.phpunit.result.cache
.phpunit.cache/
.pest/
/coverage/

# IDE, Text Editors & OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace

# AI Agents & IDE Assistants
/.gemini/
/.antigravity/
/.agents/
/.cline/
/.cursor/

# Temporary, Archive & Swap Files
*.tmp
*.swp
*.swo
*~
*.bak
*.orig
*.zip
*.tar.gz
*.rar
.directory
